# ==========================================================================
# mifature-portal — variáveis de ambiente para rodar FORA do Manus
# ==========================================================================

# --- Core ---
NODE_ENV=production
PORT=3000
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
DATABASE_URL=mysql://usuario:senha@host:4000/nome_do_banco   # ex: TiDB Cloud Starter (grátis)
OWNER_OPEN_ID=                                                 # openId do usuário "dono" (opcional, ver notas)

# --- Login com Google (substitui o Manus OAuth) ---
# Crie em https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://SEU-DOMINIO/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Armazenamento de arquivos: Cloudflare R2 (substitui o storage do Manus) ---
# Crie em https://dash.cloudflare.com/ -> R2 -> Create bucket + API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Extração automática por IA (substitui o gateway LLM do Manus) ---
# Usado na leitura automática do médico solicitante em PDFs de pedido
# médico. Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Notificações ao dono do sistema (substitui o Manus Notification Service) ---
# Opcional. Cole a URL de um "Incoming Webhook" do Slack ou Discord (ambos grátis).
# Se deixar vazio, as notificações só aparecem no log do servidor.
OWNER_NOTIFY_WEBHOOK_URL=

# --- Lembrete diário de atendimento (substitui o Heartbeat cron do Manus) ---
# Gere uma string aleatória e configure um agendador externo grátis
# (cron-job.org, GitHub Actions schedule, etc.) para chamar diariamente:
#   POST https://SEU-DOMINIO/api/scheduled/lembrete-atendimento
#   Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- WhatsApp (Evolution API) ---
# ATENÇÃO: o código-fonte original tinha uma URL e uma API key deste
# serviço HARDCODED como valor padrão (evolutionApiUrl / evolutionApiKey em
# env.ts). Isso foi removido por segurança. Se você ainda usa esse servidor
# Evolution API, recupere a URL/chave reais (fora do código) e rotacione a
# chave, já que ela esteve exposta no repositório.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Stripe (pagamentos) — já era independente do Manus, sem mudanças ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# AINDA DEPENDEM DO MANUS (não migrados nesta passagem — ver NOTAS_MIGRACAO.md)
# --------------------------------------------------------------------------
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
